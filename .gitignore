# Dependencies — this plugin has none, but keep npm/pnpm litter out of git
node_modules/
.pnpm-store/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Build or extraction leftovers
dist/
*.local

# Local host artifacts produced by the verification tools.
# These are unpacked DeepSeek Harness installation files — never commit them.
_asar_out/
_asar_q/
_asar_theme/
_asar_files.csv
_dp.css

# Session transcripts are real conversations. The verifier reads them in place;
# they must never be copied into this repository.
sessions/
*.jsonl
*.jsonl.zstd
